# Managed by Ansible. Secrets come from GARAGE_* environment variables (SOPS), never this file.
metadata_dir = "/var/lib/garage/meta"
data_dir = "/var/lib/garage/data"
db_engine = "lmdb"
replication_factor = 1

rpc_bind_addr = "{{ private_ip }}:3901"
rpc_public_addr = "{{ private_ip }}:3901"

[s3_api]
s3_region = "garage"
api_bind_addr = "127.0.0.1:3900"
root_domain = ".s3.{{ songbird_env }}.songbird.internal"

[admin]
api_bind_addr = "127.0.0.1:3903"
