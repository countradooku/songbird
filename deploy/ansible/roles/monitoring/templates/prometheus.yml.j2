# Managed by Ansible ({{ songbird_env }}). Scrapes every Songbird service's admin port.
global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    environment: "{{ songbird_env }}"

rule_files:
  - {{ prometheus_rules_dir | default('/etc/prometheus/rules') }}/*.yml

alerting:
  # Alerts leave without the private address (instance); `host` names the machine (D-0100).
  alert_relabel_configs:
    - action: labeldrop
      regex: instance
  alertmanagers:
    - static_configs:
        - targets: ["127.0.0.1:9093"]

scrape_configs:
  - job_name: songbird
    static_configs:
{% for role, services in songbird_services_by_role.items() %}
{% for host in groups.get(role, []) %}
{% for svc in services %}
      - targets: ["{{ hostvars[host].private_ip }}:{{ songbird_admin_ports[svc] }}"]
        labels:
          service: "{{ svc }}"
          host: "{{ host }}"
{% endfor %}
{% endfor %}
{% endfor %}
