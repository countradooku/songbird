#!/usr/bin/env bash
# Managed by Ansible (roles/backup_verify). Restores the newest backup of {{ verified_env }} into a
# throwaway SurrealDB and checks it (D-0040). Exit 0: verified; anything else: alert.
set -euo pipefail
db=songbird-verify-db
pass=$(head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')
cleanup() { docker rm -f "$db" >/dev/null 2>&1 || true; }
trap cleanup EXIT
cleanup
# In memory, loopback only, gone when this script ends: no copy of the registry stays here.
docker run -d --rm --name "$db" --network host --user 65532:65532 --read-only \
  --cap-drop ALL --security-opt no-new-privileges \
  -e SURREAL_USER=root -e SURREAL_PASS="$pass" \
  {{ images.surrealdb }} start --bind 127.0.0.1:18000 --log warn memory >/dev/null
for _ in $(seq 1 60); do
  curl -fsS http://127.0.0.1:18000/health >/dev/null 2>&1 && break
  sleep 1
done
SURREAL_PASS="$pass" docker run --rm --network host --read-only --user 65532:65532 \
  --cap-drop ALL --security-opt no-new-privileges \
  --env-file /etc/songbird/backup-verify.env -e SURREAL_PASS \
  -v /etc/songbird/backup-verify.key:/key/identity:ro \
  {{ songbird_registry }}/songbird-admin:{{ songbird_version }} \
  backup verify --addr 127.0.0.1:18000 --host localhost --user root \
  --namespace songbird --database verify \
  --s3-addr {{ backup_s3_endpoint }} --s3-tls --s3-region {{ backup_s3_region }} \
  --s3-bucket {{ verify_secrets.backup_s3_bucket }} \
  --identity /key/identity --age /usr/local/bin/age --max-age-hours 1
# For the monitoring this environment gains with the observability work: the time of the last
# successful verification, as a Prometheus text-format sample.
printf 'songbird_backup_verified_timestamp_seconds %s\n' "$(date +%s)" \
  > /var/lib/songbird/verify/metrics.prom
