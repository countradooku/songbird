#!/usr/bin/env bash
# Regenerates .sops.yaml from deploy/secrets/recipients/*.txt (age public keys, one per line).
#   <env>.txt   recipients of deploy/secrets/<env>.sops.yaml (owner + that environment's CI key)
#   owner.txt   recipients of the owner-only files (never a CI key): deploy/secrets/*.root-ca.sops.yaml,
#               backups.sops.yaml (the off-site bucket's administration) and *.backup-verify.sops.yaml
#               (the identity that decrypts backups and the key that reads them, D-0040)
# After changing recipients: sops updatekeys <file> for every affected file.
source "$(dirname "$0")/lib.sh"
rec_dir="$DEPLOY_DIR/secrets/recipients"
join() { grep -v '^\s*#' "$1" | grep -v '^\s*$' | paste -sd, -; }
{
  echo "# Generated by deploy/bin/sops-config from deploy/secrets/recipients/. Do not edit by hand."
  echo "creation_rules:"
  if [ -f "$rec_dir/owner.txt" ]; then
    echo "  - path_regex: ^deploy/secrets/([a-z0-9-]+\\.root-ca|[a-z0-9-]+\\.backup-verify|backups)\\.sops\\.yaml\$"
    echo "    age: \"$(join "$rec_dir/owner.txt")\""
  fi
  for f in "$rec_dir"/*.txt; do
    [ -e "$f" ] || continue
    e=$(basename "$f" .txt); [ "$e" = owner ] && continue
    echo "  - path_regex: ^deploy/secrets/${e}\\.sops\\.yaml\$"
    echo "    age: \"$(join "$f")\""
  done
} > "$REPO_DIR/.sops.yaml"
