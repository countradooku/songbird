#!/usr/bin/env bash
# Creates the encrypted secrets for a new environment. Run once per environment, on the owner's
# machine. Nothing is written in plain text inside the repository.
#   deploy/bin/secrets-init <env>
# Produces:
#   deploy/secrets/<env>.sops.yaml          deploy secrets (owner + CI recipients)
#   deploy/secrets/<env>.root-ca.sops.yaml  root CA key (owner only; needed only to renew the
#                                           intermediate CA, see docs/RUNBOOKS/mtls-rotation.md)
# Generated values: Valkey/SurrealDB/Garage/LiveKit credentials, OpenTofu state passphrase, deploy
# SSH key, internal CA (root + intermediate). Values the providers issue (API tokens, state bucket
# keys) and the admin source ranges are CHANGE_ME: set them with `sops edit deploy/secrets/<env>.sops.yaml`.
source "$(dirname "$0")/lib.sh"
[ $# -eq 1 ] || die "usage: secrets-init <env>"
env=$1
[[ "$env" =~ ^[a-z][a-z0-9-]{1,20}$ ]] || die "bad environment name"
need sops age-keygen ssh-keygen python3 songbird-admin
out="$DEPLOY_DIR/secrets/$env.sops.yaml"
root_out="$DEPLOY_DIR/secrets/$env.root-ca.sops.yaml"
[ ! -e "$out" ] || die "$out exists; edit it with sops instead"

key_file=${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/keys.txt}
if [ ! -f "$key_file" ]; then
  mkdir -p "$(dirname "$key_file")"; (umask 077; age-keygen -o "$key_file" 2>/dev/null)
  log "created your age key at $key_file. Back it up offline; losing it loses every secret."
fi
owner_pub=$(age-keygen -y "$key_file")
rec_dir="$DEPLOY_DIR/secrets/recipients"
[ -f "$rec_dir/owner.txt" ] || echo "$owner_pub" > "$rec_dir/owner.txt"
[ -f "$rec_dir/$env.txt" ] || cp "$rec_dir/owner.txt" "$rec_dir/$env.txt"
"$DEPLOY_DIR/bin/sops-config"

work=$(mktemp -d); trap 'rm -rf "$work"' EXIT; chmod 700 "$work"
rand() { python3 -c "import secrets,sys; print(secrets.token_hex(int(sys.argv[1])))" "$1"; }
ssh-keygen -q -t ed25519 -N '' -C "songbird-$env-deploy" -f "$work/deploy"
songbird-admin ca init-root --out "$work/root" --env "$env"
songbird-admin ca init-intermediate --root "$work/root" --out "$work/ca" --env "$env"

python3 - "$work" "$env" > "$work/secrets.yaml" <<'PY'
import json, pathlib, secrets, sys
w = pathlib.Path(sys.argv[1]); env = sys.argv[2]
r = lambda n: secrets.token_hex(n)
doc = {
  "active_cloud": "hetzner",
  "admin_cidrs_json": json.dumps(["CHANGE_ME/32"]),
  "hcloud_token": "CHANGE_ME", "scw_access_key": "CHANGE_ME", "scw_secret_key": "CHANGE_ME",
  "scw_project_id": "CHANGE_ME",
  "state_access_key_hetzner": "CHANGE_ME", "state_secret_key_hetzner": "CHANGE_ME",
  "state_access_key_scaleway": "CHANGE_ME", "state_secret_key_scaleway": "CHANGE_ME",
  "tofu_state_passphrase": r(32),
  # Read-only GHCR token for hosts to pull private images; set to "public" if packages are public.
  "ghcr_username": "CHANGE_ME", "ghcr_read_token": "CHANGE_ME",
  "deploy_ssh_private_key": (w / "deploy").read_text(),
  "deploy_ssh_public_key": (w / "deploy.pub").read_text().strip(),
  "surrealdb_user": "root", "surrealdb_password": r(24),
  "iggy_user": "iggy", "iggy_password": r(24),
  "valkey_hot_password": r(32), "valkey_jobs_password": r(32),
  "garage_rpc_secret": r(32), "garage_admin_token": r(32), "garage_metrics_token": r(32),
  "livekit_api_key": "sb" + r(6), "livekit_api_secret": r(32),
  "pki_root_crt": (w / "root/root.crt").read_text(),
  "pki_intermediate_crt": (w / "ca/intermediate.crt").read_text(),
  "pki_intermediate_key": (w / "ca/intermediate.key").read_text(),
}
# Block scalars keep PEM and SSH keys readable in `sops edit`.
def emit(k, v):
    if "\n" in v:
        print(f"{k}: |"); [print(f"  {l}") for l in v.rstrip("\n").split("\n")]
    else:
        print(f"{k}: {json.dumps(v)}")
for k, v in doc.items(): emit(k, v)
PY
python3 - "$work" > "$work/root.yaml" <<'PY'
import pathlib, sys
w = pathlib.Path(sys.argv[1])
print("pki_root_key: |"); [print(f"  {l}") for l in (w / "root/root.key").read_text().rstrip("\n").split("\n")]
print("pki_root_crt: |"); [print(f"  {l}") for l in (w / "root/root.crt").read_text().rstrip("\n").split("\n")]
PY
( cd "$REPO_DIR" && sops encrypt --filename-override "deploy/secrets/$env.sops.yaml" "$work/secrets.yaml" > "$out" )
( cd "$REPO_DIR" && sops encrypt --filename-override "deploy/secrets/$env.root-ca.sops.yaml" "$work/root.yaml" > "$root_out" )
log "wrote $out and $root_out (encrypted). Next: sops edit $out  # fill every CHANGE_ME"
log "add the CI recipient for $env to deploy/secrets/recipients/$env.txt, then deploy/bin/sops-config && sops updatekeys $out"
