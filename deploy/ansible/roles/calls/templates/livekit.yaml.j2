# Managed by Ansible. Keys come from LIVEKIT_KEYS (SOPS). Public signalling over TLS and TURN/TLS
# are configured in Prompt 7; until then the API listens on the private address only.
port: 7880
bind_addresses: ["{{ private_ip }}"]
rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 60000
  use_external_ip: true
logging:
  json: true
  level: info
room:
  empty_timeout: 60
