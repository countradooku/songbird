# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/


# Songbird: never commit secrets or local tooling state
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.p8
age.key
keys.txt
.DS_Store
.claude/settings.local.json

# Fuzzing and build outputs
fuzz/target
fuzz/artifacts
fuzz/coverage
junit.xml

# Fuzz corpora: only hand-picked seeds are committed
fuzz/corpus/*/*
!fuzz/corpus/*/seed-*

# OpenTofu: provider lock files ARE committed (deploy/tofu/envs/*/.terraform.lock.hcl)
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
deploy/tofu/state/
# Generated Ansible inventory (contains public IPs)
deploy/ansible/inventory/generated/

# Ansible collections installed locally
deploy/ansible/.collections/

# SBOMs are release artifacts (target/dist), never source files
*.cdx.json
# Provider-switch drill timings (copied into the drill report)
deploy/drill-timings.tsv
