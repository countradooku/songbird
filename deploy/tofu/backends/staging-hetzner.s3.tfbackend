# State for staging@hetzner, at Hetzner Object Storage in Helsinki, in a project that holds only
# OpenTofu state (D-0042): another location than the servers, and keys that reach nothing else.
bucket                      = "songbird-tofu-state"
key                         = "staging/hetzner.tfstate"
region                      = "hel1"
endpoints                   = { s3 = "https://hel1.your-objectstorage.com" }
skip_credentials_validation = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_s3_checksum            = true
use_lockfile                = true
